{
  "name": "@intelena/association-set-cli",
  "version": "0.1.0",
  "description": "CLI for @intelena/association-set — build, verify, prove and diff association-set snapshots.",
  "license": "MIT",
  "type": "module",
  "bin": { "association-set": "./dist/cli.js" },
