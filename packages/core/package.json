  "description": "Curate proof-of-innocence association sets from shielded-pool deposits: policy rules, Merkle snapshots, membership proofs, diffs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
