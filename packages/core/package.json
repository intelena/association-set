  },
  "dependencies": {
    "@intelena/shielded-notes": "file:../../../shielded-notes/packages/core"
  },
  "keywords": ["privacy", "proof-of-innocence", "association-set", "privacy-pools", "compliance", "merkle", "intelena"],
  "repository": { "type": "git", "url": "https://github.com/intelena/association-set", "directory": "packages/core" }
